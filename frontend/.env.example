# When deployed on Vercel (frontend + backend same domain):
#   Leave VITE_API_URL unset — /api/* routing is handled automatically.
#
# When backend is on a separate host (e.g. Railway):
#   Set VITE_API_URL to the backend domain only (no trailing slash, no /api).
#   Example: VITE_API_URL=https://ironplan-mini.up.railway.app

# VITE_API_URL=

VITE_FACILITY_ID=11111111-1111-1111-1111-111111111111
